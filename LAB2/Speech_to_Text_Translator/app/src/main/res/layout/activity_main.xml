<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/choose_lang"
        android:textSize="16sp" />

    <Spinner
        android:id="@+id/lang_spinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:entries="@array/languages"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_original"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_original"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#EEEEEE"
        android:textColor="#000000"
        android:padding="10dp"
        android:text="@string/hint_waiting"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_translated"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txt_translated"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="#E3F2FD"
        android:padding="10dp"
        android:textColor="#0D47A1"
        android:text="@string/hint_translated"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btn_record"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_record_text"
        android:textColor="#FFFFFF"
        android:backgroundTint="#4CAF50" />

</LinearLayout>